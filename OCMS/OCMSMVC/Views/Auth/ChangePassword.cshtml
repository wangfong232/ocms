@model OCMSMVC.Models.ChangePasswordViewModel
@{
	ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container py-4" style="max-width: 500px;">
	<div class="card border-1 rounded-3">
		<div class="card-header bg-white py-3 border-bottom">
			<h5 class="fw-bold text-primary mb-0">Đổi Mật Khẩu</h5>
			<small class="text-muted">Nhập mật khẩu hiện tại và mật khẩu mới để cập nhật bảo mật tài khoản.</small>
		</div>
		<div class="card-body p-4">
			<form asp-action="ChangePassword" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

				<div class="mb-3">
					<label asp-for="CurrentPassword" class="form-label fw-semibold text-dark small">Mật khẩu hiện tại:</label>
					<input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu cũ..." />
					<span asp-validation-for="CurrentPassword" class="text-danger small"></span>
				</div>

				<div class="mb-3">
					<label asp-for="NewPassword" class="form-label fw-semibold text-dark small">Mật khẩu mới (tối thiểu 6 ký tự):</label>
					<input asp-for="NewPassword" class="form-control" placeholder="Nhập mật khẩu mới..." />
					<span asp-validation-for="NewPassword" class="text-danger small"></span>
				</div>

				<div class="mb-4">
					<label asp-for="ConfirmNewPassword" class="form-label fw-semibold text-dark small">Xác nhận mật khẩu mới:</label>
					<input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới..." />
					<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
				</div>

				<div class="p-3 bg-light rounded-3 border mb-3">
					<div class="d-flex justify-content-between align-items-center mb-2">
						<label asp-for="OtpCode" class="form-label fw-bold mb-0 text-primary small">
							<i class="bi bi-envelope-check me-1"></i>Mã OTP qua Email (@ViewBag.UserEmail)
						</label>
						<button type="button" id="btnSendOtp" class="btn btn-sm btn-outline-primary">
							<i class="bi bi-send me-1"></i>Nhận mã OTP
						</button>
					</div>
					<input asp-for="OtpCode" class="form-control text-center fw-bold fs-5" style="letter-spacing: 5px;" maxlength="6" placeholder="000000" />
					<span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
					<div id="otpStatus" class="small mt-2"></div>
				</div>

				<div class="d-flex justify-content-between gap-2 pt-2 border-top">
					<a asp-action="Profile" class="btn btn-sm btn-light border px-3">Quay lại hồ sơ</a>
					<button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold">Cập nhật mật khẩu</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		document.getElementById('btnSendOtp').addEventListener('click', function() {
			const btn = this;
			btn.disabled = true;
			btn.innerText = "Đang gửi...";
			fetch('/Auth/SendChangePasswordOtp', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
				}
			})
				.then(res => res.json())
				.then(data => {
					const statusEl = document.getElementById('otpStatus');
					if (data.success) {
						statusEl.className = 'small text-success mt-1';
						statusEl.innerText = data.message;
					} else {
						statusEl.className = 'small text-danger mt-1';
						statusEl.innerText = data.message;
					}
					setTimeout(() => {
						btn.disabled = false;
						btn.innerHTML = '<i class="bi bi-send me-1"></i>Gửi lại mã OTP';
					}, 10000);
				});
		});
	</script>
}