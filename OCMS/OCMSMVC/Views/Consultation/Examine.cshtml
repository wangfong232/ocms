@model OCMSMVC.Models.ConsultationExamineViewModel
@{
    ViewData["Title"] = $"Khám bệnh - {Model.PatientName}";
    bool isCompleted = Model.Status == "Completed";
}

<div class="container-fluid py-3 px-lg-4">
    <!-- Top Bar: Thông tin ca khám & Bệnh nhân -->
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Queue" class="btn btn-outline-secondary btn-sm" title="Quay lại hàng đợi">
                        <i class="bi bi-arrow-left me-1"></i>Hàng đợi
                    </a>
                    <div class="vr d-none d-sm-block"></div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold text-primary mb-0">@Model.PatientName</h4>
                            <span class="badge @(Model.Gender == "Nam" ? "bg-primary-subtle text-primary" : "bg-danger-subtle text-danger") border">
                                @Model.Gender
                            </span>
                            <span class="badge bg-light text-dark border">
                                @Model.Age tuổi (@Model.DateOfBirth.ToString("dd/MM/yyyy"))
                            </span>
                        </div>
                        <div class="small text-muted mt-1">
                            <span><i class="bi bi-telephone me-1"></i>@Model.PhoneNumber</span>
                            @if (!string.IsNullOrEmpty(Model.HealthInsuranceNumber))
                            {
                                <span class="ms-3"><i class="bi bi-card-heading me-1"></i>BHYT: <strong>@Model.HealthInsuranceNumber</strong></span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <span class="ms-3 d-none d-md-inline"><i class="bi bi-geo-alt me-1"></i>@Model.Address</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 text-end">
                    <div>
                        <div class="small text-muted">Khung giờ: <strong>@Model.TimeSlotDisplay</strong></div>
                        <div>
                            @if (isCompleted)
                            {
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Đã hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-person-pulse me-1"></i>Đang trong bàn khám</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 2 Cột Bàn khám bệnh -->
    <div class="row g-3">
        <!-- Cột Trái: Tiền sử, Lý do khám & Chỉ số sinh tồn (Vital Signs) -->
        <div class="col-lg-5">
            <!-- 1. Chỉ số sinh tồn (Vital Signs) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-danger mb-0">
                        <i class="bi bi-heart-pulse me-1"></i>Chỉ số sinh tồn (Vital Signs)
                    </h6>
                    @if (Model.HasVitalSigns)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle small">Đã tiếp đón đo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary small">Chưa có dữ liệu</span>
                    }
                </div>
                <div class="card-body p-3">
                    @if (Model.HasVitalSigns)
                    {
                        <div class="row g-2 text-center">
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Huyết áp (BP)</small>
                                    <strong class="fs-6 @(Model.SystolicBP >= 140 ? "text-danger" : "text-dark")">
                                        @Model.SystolicBP/@Model.DiastolicBP
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">mmHg</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Mạch (Pulse)</small>
                                    <strong class="fs-6 text-dark">@Model.Pulse</strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">lần/phút</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Nhiệt độ (T°)</small>
                                    <strong class="fs-6 @(Model.Temperature >= 38 ? "text-danger" : "text-dark")">
                                        @Model.Temperature.ToString("0.0")
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">°C</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">SpO2</small>
                                    <strong class="fs-6 @(Model.SpO2 < 95 ? "text-danger" : "text-dark")">
                                        @Model.SpO2%
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">Oxy máu</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Cân nặng</small>
                                    <strong class="fs-6 text-dark">@Model.Weight</strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">kg</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Chiều cao</small>
                                    <strong class="fs-6 text-dark">@Model.Height</strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">cm</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">BMI</small>
                                    <strong class="fs-6 text-primary">@Model.BMI</strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">kg/m²</small>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-2">
                            <i class="bi bi-info-circle me-1"></i>Bệnh nhân chưa được điều dưỡng đo sinh hiệu ở bàn tiếp đón.
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Lý do đến khám (Chief Complaint) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-2">
                    <h6 class="fw-bold text-secondary mb-0">
                        <i class="bi bi-chat-left-dots me-1"></i>Lý do đến khám (Chief Complaint)
                    </h6>
                </div>
                <div class="card-body p-3">
                    <p class="mb-0 text-dark">
                        @(string.IsNullOrEmpty(Model.ChiefComplaint) ? "Bệnh nhân không ghi chú lý do cụ thể (khám định kỳ)." : Model.ChiefComplaint)
                    </p>
                </div>
            </div>

            <!-- 3. Tiền sử các lần khám trước -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-secondary mb-0">
                        <i class="bi bi-clock-history me-1"></i>Lịch sử khám bệnh trước đây
                    </h6>
                    <span class="badge bg-light text-muted border">@Model.PastHistory.Count lần</span>
                </div>
                <div class="card-body p-3" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.PastHistory == null || !Model.PastHistory.Any())
                    {
                        <div class="text-center py-3 text-muted small">
                            <i class="bi bi-journal-x fs-3 d-block mb-1 opacity-50"></i>
                            Đây là lần khám đầu tiên của bệnh nhân tại phòng khám.
                        </div>
                    }
                    else
                    {
                        <div class="timeline">
                            @foreach (var ph in Model.PastHistory)
                            {
                                <div class="p-2 mb-2 border rounded bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-primary small">
                                            <i class="bi bi-calendar3 me-1"></i>@ph.Date.ToString("dd/MM/yyyy")
                                        </strong>
                                        <small class="text-muted">BS: @ph.DoctorName</small>
                                    </div>
                                    <div class="small mb-1">
                                        <strong>Chẩn đoán:</strong> @ph.Diagnosis
                                        @if (!string.IsNullOrEmpty(ph.ICD10Code))
                                        {
                                            <span class="badge bg-secondary ms-1">@ph.ICD10Code</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(ph.DoctorNotes))
                                    {
                                        <div class="small text-muted">
                                            <em>Lời dặn: @ph.DoctorNotes</em>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột Phải: Chỉ định xét nghiệm nhanh & Ghi nhận Bệnh án EMR -->
        <div class="col-lg-7">
            <!-- 1. Chỉ định xét nghiệm nhanh cận lâm sàng (Rapid Diagnostics) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-primary mb-0">
                        <i class="bi bi-eyedropper me-1"></i>Chỉ định xét nghiệm nhanh tại phòng khám
                    </h6>
                    <span class="badge bg-primary-subtle text-primary border">@Model.ServiceOrders.Count chỉ định</span>
                </div>
                <div class="card-body p-3">
                    <!-- Form thêm chỉ định xét nghiệm -->
                    @if (!isCompleted)
                    {
                        <form asp-action="OrderService" method="post" class="row g-2 mb-3 pb-3 border-bottom">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                            <div class="col-sm-8">
                                <select name="serviceId" class="form-select form-select-sm" required>
                                    <option value="">-- Chọn xét nghiệm / Dịch vụ cận lâm sàng --</option>
                                    @foreach (var s in Model.AvailableServices)
                                    {
                                        <option value="@s.ServiceId">
                                            @s.Name (@s.Price.ToString("N0") đ) - @s.DepartmentName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm chỉ định
                                </button>
                            </div>
                        </form>
                    }

                    <!-- Danh sách các chỉ định đã gọi -->
                    @if (!Model.ServiceOrders.Any())
                    {
                        <div class="text-muted small text-center py-2">
                            Chưa có chỉ định xét nghiệm nào trong lần khám này.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tên xét nghiệm</th>
                                        <th style="width: 110px;">Đơn giá</th>
                                        <th>Kết quả tóm tắt</th>
                                        <th class="text-center" style="width: 100px;">Trạng thái</th>
                                        @if (!isCompleted)
                                        {
                                            <th class="text-center" style="width: 60px;">Xóa</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.ServiceOrders)
                                    {
                                        <tr>
                                            <td class="fw-medium small">@order.ServiceName</td>
                                            <td class="small text-muted">@order.UnitPrice.ToString("N0") đ</td>
                                            <td>
                                                @if (!isCompleted)
                                                {
                                                    <form asp-action="UpdateServiceResult" method="post" class="d-flex gap-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                                                        <input type="hidden" name="serviceOrderId" value="@order.ServiceOrderId" />
                                                        <input type="text" name="resultSummary" value="@order.ResultSummary" 
                                                               class="form-control form-control-sm" placeholder="Nhập kết quả..." />
                                                        <button type="submit" name="markCompleted" value="true" 
                                                                class="btn btn-sm btn-outline-success" title="Lưu & Đánh dấu hoàn tất">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="small">@(string.IsNullOrEmpty(order.ResultSummary) ? "Chưa có kết quả" : order.ResultSummary)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (order.Status == "Completed")
                                                {
                                                    <span class="badge bg-success small">Đã xong</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark small">Chờ KQ</span>
                                                }
                                            </td>
                                            @if (!isCompleted)
                                            {
                                                <td class="text-center">
                                                    <form asp-action="DeleteService" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy chỉ định này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                                                        <input type="hidden" name="serviceOrderId" value="@order.ServiceOrderId" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Hủy">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Ghi nhận Bệnh án & Chẩn đoán EMR (ICD-10) -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-2">
                    <h6 class="fw-bold text-success mb-0">
                        <i class="bi bi-file-earmark-medical me-1"></i>Hồ sơ Bệnh án Điện tử (EMR) &amp; Chẩn đoán
                    </h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="SaveEMR" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

                        <!-- Chẩn đoán chính -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Chẩn đoán lâm sàng <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="diagnosis" class="form-control" value="@Model.Diagnosis" 
                                   placeholder="Ví dụ: Viêm họng cấp do virus, Viêm phế quản..." required @(isCompleted ? "readonly" : "") />
                        </div>

                        <!-- Mã ICD-10 & Ngày tái khám -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">
                                    Mã bệnh ICD-10
                                </label>
                                <div class="input-group">
                                    <input type="text" name="icd10Code" class="form-control" value="@Model.ICD10Code" 
                                           placeholder="J00, I10, E11..." maxlength="20" @(isCompleted ? "readonly" : "") />
                                    <span class="input-group-text bg-light text-muted small">ICD-10</span>
                                </div>
                                <div class="form-text small text-muted">Ví dụ: J00 (Cảm lạnh), I10 (Tăng huyết áp), E11 (Tiểu đường type 2)</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">
                                    Ngày hẹn tái khám (nếu có)
                                </label>
                                <input type="date" name="followUpDate" class="form-control" 
                                       value="@(Model.FollowUpDate?.ToString("yyyy-MM-dd"))" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @(isCompleted ? "readonly" : "") />
                            </div>
                        </div>

                        <!-- Lời dặn của Bác sĩ -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold small">
                                Lời dặn dò &amp; Ghi chú của Bác sĩ
                            </label>
                            <textarea name="doctorNotes" rows="3" class="form-control" 
                                      placeholder="Chế độ ăn uống, sinh hoạt, kiêng cữ hoặc lưu ý theo dõi..." @(isCompleted ? "readonly" : "")>@Model.DoctorNotes</textarea>
                        </div>

                        <!-- Action Buttons -->
                        @if (!isCompleted)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="submit" name="completeConsultation" value="false" class="btn btn-outline-primary px-3 shadow-sm">
                                    <i class="bi bi-save me-1"></i>Lưu tạm bệnh án
                                </button>
                                <button type="submit" name="completeConsultation" value="true" class="btn btn-success px-4 shadow-sm"
                                        onclick="return confirm('Bạn có chắc chắn muốn hoàn thành ca khám này? Sau khi hoàn thành, bệnh nhân sẽ rời khỏi hàng đợi khám.');">
                                    <i class="bi bi-check2-all me-1"></i>Hoàn thành ca khám
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 mb-0 small">
                                <i class="bi bi-check-circle-fill me-1"></i>Ca khám này đã được hoàn thành. Thông tin bệnh án đã được lưu trữ bảo mật trong hệ thống.
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

