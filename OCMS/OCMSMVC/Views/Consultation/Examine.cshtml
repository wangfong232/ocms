@model OCMSMVC.Models.ConsultationExamineViewModel
@{
    ViewData["Title"] = $"Hồ sơ bệnh án - {Model.PatientName}";
    bool isCompleted = Model.Status == "Completed";
}

<div class="container-fluid py-3 px-lg-4">
    <!-- Header: Thông tin ca khám & Bệnh nhân -->
    <div class="card border mb-3 bg-white">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Queue" class="btn btn-outline-secondary btn-sm">&larr; Hàng đợi</a>
                    <div class="vr d-none d-sm-block"></div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold text-primary mb-0">@Model.PatientName</h5>
                            <span class="badge @(Model.Gender == "Nam" ? "bg-primary" : "bg-danger")">
                                @Model.Gender
                            </span>
                            <span class="badge bg-light text-dark border">
                                @Model.Age tuổi (@Model.DateOfBirth.ToString("dd/MM/yyyy"))
                            </span>
                        </div>
                        <div class="small text-muted mt-1">
                            <span class="me-3">SĐT: @Model.PhoneNumber</span>
                            @if (!string.IsNullOrEmpty(Model.HealthInsuranceNumber))
                            {
                                <span class="me-3">BHYT: @Model.HealthInsuranceNumber</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <span>Địa chỉ: @Model.Address</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <div class="small text-muted">Khung giờ: <strong>@Model.TimeSlotDisplay</strong></div>
                    <div class="mt-1">
                        @if (isCompleted)
                        {
                            <span class="badge bg-success">Đã hoàn thành</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Đang khám</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages (Hiển thị dạng success message màu xanh) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 2 Cột Bàn khám -->
    <div class="row g-3">
        <!-- Cột Trái: Sinh hiệu & Tiền sử -->
        <div class="col-lg-5">
            <!-- 1. Chỉ số sinh tồn -->
            <div class="card border mb-3">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-danger">Chỉ số sinh tồn</span>
                    @if (Model.HasVitalSigns)
                    {
                        <span class="badge bg-success">Đã đo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa đo</span>
                    }
                </div>
                <div class="card-body p-3">
                    @if (Model.HasVitalSigns)
                    {
                        <div class="row g-2 text-center mb-2">
                            <div class="col-6 col-sm-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Huyết áp</small>
                                    <strong class="@(Model.SystolicBP >= 140 ? "text-danger" : "text-dark")">
                                        @Model.SystolicBP/@Model.DiastolicBP
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">mmHg</small>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Mạch</small>
                                    <strong class="text-dark">@Model.Pulse</strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">lần/phút</small>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Thân nhiệt</small>
                                    <strong class="@(Model.Temperature >= 38 ? "text-danger" : "text-dark")">
                                        @Model.Temperature.ToString("0.0")
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">°C</small>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">SpO2</small>
                                    <strong class="@(Model.SpO2 < 95 ? "text-danger" : "text-dark")">
                                        @Model.SpO2%
                                    </strong>
                                    <small class="text-muted d-block" style="font-size:0.65rem;">Oxy</small>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Chiều cao</small>
                                    <strong class="text-dark">@Model.Height cm</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">Cân nặng</small>
                                    <strong class="text-dark">@Model.Weight kg</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size:0.75rem;">BMI</small>
                                    <strong class="text-primary">@Model.BMI</strong>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-2">
                            Chưa có dữ liệu sinh hiệu đo từ khâu tiếp đón.
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Lý do khám & Tiền sử -->
            <div class="card border">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-secondary">Lý do khám &amp; Tiền sử bệnh</span>
                    <span class="badge bg-light text-dark border">@Model.PastHistory.Count lần trước</span>
                </div>
                <div class="card-body p-3">
                    <!-- Lý do khám -->
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted fw-semibold d-block mb-1">Lý do đến khám hôm nay:</small>
                        <div class="p-2 bg-light rounded border small text-dark">
                            @(string.IsNullOrEmpty(Model.ChiefComplaint) ? "Khám bệnh định kỳ." : Model.ChiefComplaint)
                        </div>
                    </div>

                    <!-- Tiền sử khám -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted fw-semibold">Lịch sử các lần khám trước:</small>
                            @if (Model.PastHistory.Count > 3)
                            {
                                <small class="text-muted fst-italic">Cuộn xem thêm (@Model.PastHistory.Count lần)</small>
                            }
                        </div>
                        <div style="max-height: 240px; overflow-y: auto;">
                            @if (Model.PastHistory == null || !Model.PastHistory.Any())
                            {
                                <div class="text-center py-3 text-muted small bg-light rounded border">
                                    Chưa có lịch sử khám trước đây tại phòng khám.
                                </div>
                            }
                            else
                            {
                                @foreach (var ph in Model.PastHistory)
                                {
                                    <div class="p-2 mb-2 border rounded bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-primary small">@ph.Date.ToString("dd/MM/yyyy")</strong>
                                            <small class="text-muted">BS: @ph.DoctorName</small>
                                        </div>
                                        <div class="small">
                                            <strong>Chẩn đoán:</strong> @ph.Diagnosis
                                            @if (!string.IsNullOrEmpty(ph.ICD10Code))
                                            {
                                                <span class="badge bg-secondary ms-1">@ph.ICD10Code</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(ph.DoctorNotes))
                                        {
                                            <div class="small text-muted mt-1 text-truncate">Lời dặn: @ph.DoctorNotes</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Xét nghiệm nhanh, Kê đơn thuốc & Bệnh án EMR -->
        <div class="col-lg-7">
            <!-- 1. Chỉ định xét nghiệm nhanh -->
            <div class="card border mb-3">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-primary">Chỉ định cận lâm sàng / Xét nghiệm nhanh</span>
                    <span class="badge bg-primary">@Model.ServiceOrders.Count</span>
                </div>
                <div class="card-body p-3">
                    @if (!isCompleted)
                    {
                        <form asp-action="OrderService" method="post" class="row g-2 mb-3 pb-3 border-bottom">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                            <div class="col-sm-9">
                                <select name="serviceId" class="form-select form-select-sm" required>
                                    <option value="">-- Chọn xét nghiệm / Dịch vụ --</option>
                                    @foreach (var s in Model.AvailableServices)
                                    {
                                        <option value="@s.ServiceId">
                                            @s.Name (@s.Price.ToString("N0") đ) - @s.DepartmentName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Chỉ định</button>
                            </div>
                        </form>
                    }

                    @if (!Model.ServiceOrders.Any())
                    {
                        <div class="text-muted small text-center py-2">
                            Chưa có chỉ định xét nghiệm nào trong ca khám này.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tên xét nghiệm</th>
                                        <th style="width: 100px;">Đơn giá</th>
                                        <th>Kết quả</th>
                                        <th class="text-center" style="width: 90px;">Trạng thái</th>
                                        @if (!isCompleted)
                                        {
                                            <th class="text-center" style="width: 50px;">Xóa</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.ServiceOrders)
                                    {
                                        <tr>
                                            <td class="small fw-semibold">@order.ServiceName</td>
                                            <td class="small text-muted">@order.UnitPrice.ToString("N0") đ</td>
                                            <td>
                                                @if (!isCompleted)
                                                {
                                                    <form asp-action="UpdateServiceResult" method="post" class="d-flex gap-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                                                        <input type="hidden" name="serviceOrderId" value="@order.ServiceOrderId" />
                                                        <input type="text" name="resultSummary" value="@order.ResultSummary" 
                                                               class="form-control form-control-sm" placeholder="Nhập kết quả..." />
                                                        <button type="submit" name="markCompleted" value="true" 
                                                                class="btn btn-sm btn-outline-success text-nowrap">Lưu</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="small">@(string.IsNullOrEmpty(order.ResultSummary) ? "Chưa có" : order.ResultSummary)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (order.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Đã xong</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Chờ KQ</span>
                                                }
                                            </td>
                                            @if (!isCompleted)
                                            {
                                                <td class="text-center">
                                                    <form asp-action="DeleteService" method="post" class="delete-service-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                                                        <input type="hidden" name="serviceOrderId" value="@order.ServiceOrderId" />
                                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="promptDeleteService(this)">Hủy</button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Kê đơn thuốc điều trị (Lấy từ DB, gửi sang Cấp phát thuốc) -->
            <div class="card border mb-3">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-primary">Kê đơn thuốc điều trị</span>
                    <span class="badge bg-primary" id="prescriptionsBadge">@Model.Prescriptions.Count</span>
                </div>
                <div class="card-body p-3">
                    @if (!isCompleted)
                    {
                        <div class="p-2 mb-3 bg-light rounded border">
                            <!-- Hàng 1: Tìm kiếm & Chọn thuốc từ DB -->
                            <div class="row g-2 mb-2">
                                <div class="col-md-5">
                                    <label class="form-label small text-muted mb-1">Tìm kiếm thuốc trong kho:</label>
                                    <input type="text" id="medSearchInput" class="form-control form-control-sm" 
                                           placeholder="Gõ tên thuốc (Panadol, Cefuroxime...)" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small text-muted mb-1">Chọn thuốc:</label>
                                    <select id="medSelect" class="form-select form-select-sm">
                                        <option value="">-- Chọn thuốc từ danh mục --</option>
                                        @foreach (var m in Model.AvailableMedicines)
                                        {
                                            <option value="@m.MedicineId" data-name="@m.Name" data-unit="@m.Unit" data-price="@m.Price" data-stock="@m.StockQuantity">
                                                @m.Name (@m.Price.ToString("N0") đ / @m.Unit) - Tồn: @m.StockQuantity
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Hàng 2: Số lượng, Liều dùng & Nút thêm -->
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small text-muted mb-1">Số lượng:</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="medQuantity" class="form-control" value="1" min="1" max="1000" />
                                        <span class="input-group-text" id="medUnitBadge">ĐV</span>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small text-muted mb-1">Liều dùng &amp; Hướng dẫn:</label>
                                    <input type="text" id="medDosage" class="form-control form-control-sm" 
                                           placeholder="VD: Ngày 2 lần, mỗi lần 1 viên sau ăn" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" id="btnAddMedBtn" class="btn btn-sm btn-primary w-100">
                                        Thêm thuốc
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Bảng danh sách thuốc đã kê -->
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0" id="prescriptionsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên thuốc</th>
                                    <th style="width: 80px;" class="text-center">Số lượng</th>
                                    <th style="width: 90px;" class="text-end">Đơn giá</th>
                                    <th style="width: 105px;" class="text-end">Thành tiền</th>
                                    <th>Hướng dẫn sử dụng</th>
                                    @if (!isCompleted)
                                    {
                                        <th style="width: 50px;" class="text-center">Xóa</th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="prescriptionsTableBody">
                                @if (!Model.Prescriptions.Any())
                                {
                                    <tr id="emptyPrescriptionRow">
                                        <td colspan="@(isCompleted ? 5 : 6)" class="text-center text-muted py-2 small">
                                            Chưa có thuốc nào trong đơn.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in Model.Prescriptions)
                                    {
                                        <tr id="prescRow-@p.PrescriptionDetailId">
                                            <td class="small fw-semibold">@p.MedicineName</td>
                                            <td class="small text-center">@p.Quantity @p.Unit</td>
                                            <td class="small text-end text-muted">@p.UnitPrice.ToString("N0") đ</td>
                                            <td class="small text-end fw-semibold text-primary">@p.TotalPrice.ToString("N0") đ</td>
                                            <td class="small">@p.DosageInstruction</td>
                                            @if (!isCompleted)
                                            {
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" 
                                                            onclick="removePrescriptionItem(@p.PrescriptionDetailId)">Xóa</button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 3. Ghi nhận Hồ sơ bệnh án EMR & Kết luận -->
            <div class="card border">
                <div class="card-header bg-light py-2">
                    <span class="fw-bold small text-success">Hồ sơ bệnh án &amp; Kết luận điều trị</span>
                </div>
                <div class="card-body p-3">
                    <form asp-action="SaveEMR" method="post" id="emrForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="appointmentId" id="emrAppointmentId" value="@Model.AppointmentId" />
                        <input type="hidden" name="completeConsultation" id="completeConsultationFlag" value="false" />

                        <!-- Chẩn đoán chính -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Chẩn đoán lâm sàng <span class="text-danger">*</span></label>
                            <input type="text" name="diagnosis" id="emrDiagnosis" class="form-control" value="@Model.Diagnosis" 
                                   placeholder="Nhập chẩn đoán bệnh..." required @(isCompleted ? "readonly" : "") />
                        </div>

                        <!-- Mã ICD-10 & Ngày tái khám -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Mã bệnh ICD-10</label>
                                <input type="text" name="icd10Code" class="form-control" value="@Model.ICD10Code" 
                                       placeholder="Ví dụ: J00, I10, E11" maxlength="20" @(isCompleted ? "readonly" : "") />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Ngày hẹn tái khám</label>
                                <input type="date" name="followUpDate" class="form-control" 
                                       value="@(Model.FollowUpDate?.ToString("yyyy-MM-dd"))" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @(isCompleted ? "readonly" : "") />
                            </div>
                        </div>

                        <!-- Lời dặn -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Lời dặn của Bác sĩ / Hướng dẫn điều trị</label>
                            <textarea name="doctorNotes" rows="3" class="form-control" 
                                      placeholder="Ghi chú điều trị, chế độ sinh hoạt, đơn thuốc..." @(isCompleted ? "readonly" : "")>@Model.DoctorNotes</textarea>
                        </div>

                        <!-- Action Buttons -->
                        @if (!isCompleted)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    Lưu tạm bệnh án
                                </button>
                                <button type="button" class="btn btn-success btn-sm px-4 fw-semibold" onclick="promptCompleteConsultation()">
                                    Hoàn thành ca khám
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 mb-0 rounded bg-light border text-center small text-success fw-semibold">
                                Ca khám đã hoàn thành. Hồ sơ bệnh án và đơn thuốc đã được gửi sang quầy Cấp phát thuốc.
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Hoàn thành ca khám -->
<div class="modal fade" id="confirmCompleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border">
            <div class="modal-header py-2 bg-success text-white">
                <h6 class="modal-title fw-bold mb-0">Xác nhận hoàn thành</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p class="mb-0 text-dark small">Xác nhận hoàn tất ca khám cho bệnh nhân <strong>@Model.PatientName</strong>? Đơn thuốc sẽ được chuyển sang bộ phận Cấp phát thuốc của Lễ tân.</p>
            </div>
            <div class="modal-footer py-2 justify-content-center">
                <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-sm btn-success px-3 fw-semibold" id="btnConfirmCompleteSubmit">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Hủy chỉ định xét nghiệm -->
<div class="modal fade" id="confirmDeleteServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border">
            <div class="modal-header py-2 bg-danger text-white">
                <h6 class="modal-title fw-bold mb-0">Hủy chỉ định</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p class="mb-0 text-dark small">Bạn có chắc chắn muốn hủy chỉ định xét nghiệm này?</p>
            </div>
            <div class="modal-footer py-2 justify-content-center">
                <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-sm btn-danger px-3 fw-semibold" id="btnConfirmDeleteServiceSubmit">Đồng ý</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteForm = null;

        function promptDeleteService(btn) {
            pendingDeleteForm = btn.closest('form');
            var modalEl = document.getElementById('confirmDeleteServiceModal');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        function promptCompleteConsultation() {
            var diagInput = document.getElementById('emrDiagnosis');
            if (!diagInput || !diagInput.value.trim()) {
                if (typeof showNotificationModal === 'function') {
                    showNotificationModal("Thông báo", "Vui lòng nhập chẩn đoán lâm sàng trước khi hoàn thành ca khám.", false);
                }
                diagInput.focus();
                return;
            }

            var modalEl = document.getElementById('confirmCompleteModal');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        // Kê đơn thuốc: Tìm kiếm thuốc live từ DB
        var medSearchInput = document.getElementById('medSearchInput');
        var medSelect = document.getElementById('medSelect');
        var medUnitBadge = document.getElementById('medUnitBadge');

        function updateUnitDisplay() {
            if (!medSelect || !medUnitBadge) return;
            var opt = medSelect.options[medSelect.selectedIndex];
            var unit = opt ? opt.getAttribute('data-unit') : '';
            medUnitBadge.textContent = unit || 'ĐV';
        }

        if (medSelect) {
            medSelect.addEventListener('change', updateUnitDisplay);
        }

        if (medSearchInput) {
            var searchTimeout = null;
            medSearchInput.addEventListener('input', function () {
                var term = this.value.trim();
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    fetch('/Consultation/SearchMedicines?term=' + encodeURIComponent(term))
                        .then(function (res) { return res.json(); })
                        .then(function (data) {
                            medSelect.innerHTML = '<option value="">-- Chọn thuốc từ danh mục --</option>';
                            data.forEach(function (m) {
                                var opt = document.createElement('option');
                                opt.value = m.id;
                                opt.textContent = m.name + ' (' + m.priceDisplay + ' / ' + m.unit + ') - Tồn: ' + m.stock;
                                opt.setAttribute('data-name', m.name);
                                opt.setAttribute('data-unit', m.unit);
                                opt.setAttribute('data-price', m.price);
                                opt.setAttribute('data-stock', m.stock);
                                medSelect.appendChild(opt);
                            });
                            if (data.length === 1) {
                                medSelect.selectedIndex = 1;
                            }
                            updateUnitDisplay();
                        })
                        .catch(function (err) {
                            console.error("Lỗi tìm kiếm thuốc:", err);
                        });
                }, 300);
            });
        }

        // Thêm thuốc vào đơn (AJAX để không mất nội dung chẩn đoán chưa lưu)
        var btnAddMedBtn = document.getElementById('btnAddMedBtn');
        if (btnAddMedBtn) {
            btnAddMedBtn.addEventListener('click', function () {
                var medicineId = medSelect ? medSelect.value : '';
                if (!medicineId) {
                    if (typeof showNotificationModal === 'function') {
                        showNotificationModal("Thông báo", "Vui lòng chọn thuốc từ danh sách.", false);
                    }
                    return;
                }

                var quantity = parseInt(document.getElementById('medQuantity').value, 10) || 1;
                var dosage = document.getElementById('medDosage').value.trim();
                var appointmentId = document.getElementById('emrAppointmentId').value;
                var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenEl ? tokenEl.value : '';

                var body = '__RequestVerificationToken=' + encodeURIComponent(token) +
                           '&appointmentId=' + encodeURIComponent(appointmentId) +
                           '&medicineId=' + encodeURIComponent(medicineId) +
                           '&quantity=' + encodeURIComponent(quantity) +
                           '&dosageInstruction=' + encodeURIComponent(dosage);

                fetch('/Consultation/AddPrescriptionItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) {
                        if (typeof showNotificationModal === 'function') {
                            showNotificationModal("Thông báo", data.message, false);
                        }
                        return;
                    }

                    // Xóa dòng trống nếu có
                    var emptyRow = document.getElementById('emptyPrescriptionRow');
                    if (emptyRow) emptyRow.remove();

                    // Thêm dòng mới vào bảng
                    var tbody = document.getElementById('prescriptionsTableBody');
                    var tr = document.createElement('tr');
                    tr.id = 'prescRow-' + data.item.prescriptionDetailId;
                    tr.innerHTML = '<td class="small fw-semibold">' + data.item.medicineName + '</td>' +
                                   '<td class="small text-center">' + data.item.quantity + ' ' + data.item.unit + '</td>' +
                                   '<td class="small text-end text-muted">' + data.item.unitPriceDisplay + '</td>' +
                                   '<td class="small text-end fw-semibold text-primary">' + data.item.totalPriceDisplay + '</td>' +
                                   '<td class="small">' + (data.item.dosageInstruction || '') + '</td>' +
                                   '<td class="text-center">' +
                                   '<button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removePrescriptionItem(' + data.item.prescriptionDetailId + ')">Xóa</button>' +
                                   '</td>';
                    tbody.appendChild(tr);

                    // Cập nhật badge
                    var badge = document.getElementById('prescriptionsBadge');
                    if (badge) {
                        var count = tbody.querySelectorAll('tr[id^="prescRow-"]').length;
                        badge.textContent = count;
                    }

                    // Reset form thêm thuốc
                    document.getElementById('medDosage').value = '';
                    document.getElementById('medQuantity').value = '1';
                })
                .catch(function (err) {
                    if (typeof showNotificationModal === 'function') {
                        showNotificationModal("Thông báo", "Lỗi kết nối khi thêm thuốc.", false);
                    }
                });
            });
        }

        // Xóa thuốc khỏi đơn (AJAX)
        function removePrescriptionItem(prescriptionDetailId) {
            var appointmentId = document.getElementById('emrAppointmentId').value;
            var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenEl ? tokenEl.value : '';

            var body = '__RequestVerificationToken=' + encodeURIComponent(token) +
                       '&appointmentId=' + encodeURIComponent(appointmentId) +
                       '&prescriptionDetailId=' + encodeURIComponent(prescriptionDetailId);

            fetch('/Consultation/DeletePrescriptionItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    var row = document.getElementById('prescRow-' + prescriptionDetailId);
                    if (row) row.remove();

                    var tbody = document.getElementById('prescriptionsTableBody');
                    var rows = tbody.querySelectorAll('tr[id^="prescRow-"]');
                    var badge = document.getElementById('prescriptionsBadge');
                    if (badge) badge.textContent = rows.length;

                    if (rows.length === 0) {
                        var emptyTr = document.createElement('tr');
                        emptyTr.id = 'emptyPrescriptionRow';
                        emptyTr.innerHTML = '<td colspan="6" class="text-center text-muted py-2 small">Chưa có thuốc nào trong đơn.</td>';
                        tbody.appendChild(emptyTr);
                    }
                } else {
                    if (typeof showNotificationModal === 'function') {
                        showNotificationModal("Thông báo", data.message, false);
                    }
                }
            })
            .catch(function () {
                if (typeof showNotificationModal === 'function') {
                    showNotificationModal("Thông báo", "Không thể xóa thuốc.", false);
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            var btnCompleteConfirm = document.getElementById('btnConfirmCompleteSubmit');
            if (btnCompleteConfirm) {
                btnCompleteConfirm.addEventListener('click', function () {
                    var form = document.getElementById('emrForm');
                    var flag = document.getElementById('completeConsultationFlag');
                    if (flag) flag.value = "true";
                    if (form) form.submit();
                });
            }

            var btnDeleteConfirm = document.getElementById('btnConfirmDeleteServiceSubmit');
            if (btnDeleteConfirm) {
                btnDeleteConfirm.addEventListener('click', function () {
                    if (pendingDeleteForm) {
                        pendingDeleteForm.submit();
                    }
                });
            }
        });
    </script>
}
