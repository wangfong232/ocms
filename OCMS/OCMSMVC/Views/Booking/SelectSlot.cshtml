@model OCMSMVC.Models.SelectSlotViewModel
@{
	ViewData["Title"] = "Chọn Khung Giờ Khám";
	bool hasHeldSlot = Model.CurrentHeldSlot != null && Model.RemainingSeconds > 0;
}

<div class="container py-4">
	<!-- Bác sĩ -->
	<div class="card border-0 shadow-sm mb-4 bg-primary text-white">
		<div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
			<div>
				<a asp-action="Search" class="btn btn-sm btn-light mb-2"><i class="bi bi-arrow-left"></i> Quay lại tìm kiếm</a>
				<h3 class="fw-bold mb-1">@Model.AcademicTitle @Model.DoctorName</h3>
				<p class="opacity-75 mb-0">Chuyên khoa: @Model.DepartmentName | Ngày khám: <strong>@Model.SelectedDate.ToString("dd/MM/yyyy")</strong></p>
			</div>
			<div class="text-end">
				<span class="badge bg-white text-primary fs-6 px-3 py-2">Giá khám: @Model.PricePerSlot.ToString("N0") VNĐ</span>
			</div>
		</div>
	</div>

	<!-- Đếm ngược 10 phút -->
	<div id="countdownAlert" class="mb-4 alert alert-warning alert-dismissible fade show border-1 @(hasHeldSlot ? "" : "d-none")" role="alert">
		<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
			<div class="d-flex align-items-center">
				<i class="bi bi-clock-history fs-3 text-warning me-3"></i>
				<div>
					<div>Bạn đang giữ khung giờ: <strong id="heldTimeText" class="text-primary fs-5">@(hasHeldSlot ? $"{Model.CurrentHeldSlot!.StartTime:hh\\:mm} - {Model.CurrentHeldSlot.EndTime:hh\\:mm}" : "")</strong></div>
					<small class="text-muted">Thời gian giữ chỗ còn lại: <span id="timerDisplay" class="fw-bold text-danger fs-6">10:00</span>.</small>
				</div>
			</div>
			<a asp-action="Confirm" id="btnProceedConfirm" class="btn btn-primary fw-bold px-4 py-2">
				Xác nhận thông tin đặt lịch <i class="bi bi-arrow-right ms-1"></i>
			</a>
		</div>
	</div>

	<!-- Lưới khung giờ -->
	<div class="row g-4">
		<!-- Ca Sáng -->
		<div class="col-md-6">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-header bg-white border-bottom py-3">
					<h5 class="fw-bold text-primary mb-0"><i class="bi bi-sun me-2 text-warning"></i>Ca sáng (07:30 - 11:30)</h5>
				</div>
				<div class="card-body">
					@if (!Model.MorningSlots.Any())
					{
						<p class="text-muted text-center py-4 mb-0">Không có lịch làm việc buổi sáng.</p>
					}
					else
					{
						<div class="row g-2">
							@foreach (var slot in Model.MorningSlots)
							{
								var isPast = slot.Status == "Past";
								var btnClass = slot.IsHeldByCurrentUser ? "btn-success active" : (slot.Status == "Open" ? "btn-outline-success" : "btn-light text-muted border disabled");
								var labelText = slot.IsHeldByCurrentUser ? "Đang chọn" : (isPast ? "Đã qua" : (slot.Status == "Open" ? "Còn trống" : (slot.Status == "Hold" ? "Người khác giữ" : "Đã đặt")));

								<div class="col-6 col-sm-4">
									<button type="button"
											id="slot-btn-@slot.SlotId"
											class="btn w-100 py-2 slot-btn @btnClass"
											data-slot-id="@slot.SlotId"
											data-time="@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")"
											data-row-version="@slot.RowVersion"
										@(slot.IsClickable && !isPast ? "" : "disabled")>
										<div class="fw-bold">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</div>
										<small class="slot-status-label d-block">@labelText</small>
									</button>
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Ca Chiều -->
		<div class="col-md-6">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-header bg-white border-bottom py-3">
					<h5 class="fw-bold text-primary mb-0"><i class="bi bi-sunset me-2 text-info"></i>Ca Chiều (13:00 - 17:00)</h5>
				</div>
				<div class="card-body">
					@if (!Model.AfternoonSlots.Any())
					{
						<p class="text-muted text-center py-4 mb-0">Không có lịch làm việc buổi chiều.</p>
					}
					else
					{
						<div class="row g-2">
							@foreach (var slot in Model.AfternoonSlots)
							{
								var isPast = slot.Status == "Past";
								var btnClass = slot.IsHeldByCurrentUser ? "btn-success active" : (slot.Status == "Open" ? "btn-outline-success" : "btn-light text-muted border disabled");
								var labelText = slot.IsHeldByCurrentUser ? "Đang chọn" : (isPast ? "Đã qua" : (slot.Status == "Open" ? "Còn trống" : (slot.Status == "Hold" ? "Người khác giữ" : "Đã đặt")));

								<div class="col-6 col-sm-4">
									<button type="button"
											id="slot-btn-@slot.SlotId"
											class="btn w-100 py-2 slot-btn @btnClass"
											data-slot-id="@slot.SlotId"
											data-time="@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")"
											data-row-version="@slot.RowVersion"
										@(slot.IsClickable && !isPast ? "" : "disabled")>
										<div class="fw-bold">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</div>
										<small class="slot-status-label d-block">@labelText</small>
									</button>
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

	<script>
		let countdownInterval = null;
		const initialSeconds = @Model.RemainingSeconds;
		if (initialSeconds > 0) {
			startCountdown(initialSeconds);
		}

		document.querySelectorAll('.slot-btn').forEach(button => {
			button.addEventListener('click', function() {
				if (this.classList.contains('active') || this.disabled) return;

				const slotId = this.getAttribute('data-slot-id');
				const rowVersion = this.getAttribute('data-row-version');
				const timeRange = this.getAttribute('data-time');
				holdSlot(slotId, rowVersion, timeRange, this);
			});
		});

		function holdSlot(slotId, rowVersion, timeRange, element) {
			const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

			fetch('/Booking/HoldSlot', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': token
				},
				body: JSON.stringify({ slotId: parseInt(slotId), rowVersion: rowVersion })
			})
				.then(async response => {
					const data = await response.json();
					if (response.ok && data.success) {
						if (data.releasedSlotId) {
							const prevBtn = document.getElementById('slot-btn-' + data.releasedSlotId);
							if (prevBtn) {
								prevBtn.className = 'btn w-100 py-2 slot-btn btn-outline-success';
								prevBtn.removeAttribute('disabled');
								prevBtn.querySelector('.slot-status-label').innerText = 'Còn trống';
								if (data.releasedNewRowVersion) {
									prevBtn.setAttribute('data-row-version', data.releasedNewRowVersion);
								}
							}
						}

						element.className = 'btn w-100 py-2 slot-btn btn-success active';
						element.removeAttribute('disabled');
						element.querySelector('.slot-status-label').innerText = 'Đang chọn';
						if (data.newRowVersion) {
							element.setAttribute('data-row-version', data.newRowVersion);
						}

						document.getElementById('heldTimeText').innerText = timeRange;
						startCountdown(data.expiresIn);
					} else if (response.status === 409) {
						element.className = 'btn w-100 py-2 slot-btn btn-light text-muted border disabled';
						element.disabled = true;
						element.querySelector('.slot-status-label').innerText = 'Người khác vừa giữ';
						alert(data.message || 'Khung giờ này vừa có người giữ.');
					} else {
						alert(data.message || 'Có lỗi xảy ra khi giữ chỗ.');
					}
				}).catch(error => {
					console.error('Error:', error);
					alert('Lỗi kết nối khi giữ chỗ.');
				});
		}

		function startCountdown(seconds) {
			const alertBox = document.getElementById('countdownAlert');
			const timerDisplay = document.getElementById('timerDisplay');
			alertBox.classList.remove('d-none');

			if (countdownInterval) clearInterval(countdownInterval);
			let remaining = seconds;

			countdownInterval = setInterval(() => {
				const m = Math.floor(remaining / 60);
				const s = remaining % 60;
				timerDisplay.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

				if (remaining <= 0) {
					clearInterval(countdownInterval);
					alert('Thời gian giữ chỗ 10 phút đã hết hạn. Vui lòng chọn lại khung giờ khám.');
					window.location.reload();
				}
				remaining--;
			}, 1000);
		}

		// ==========================================
		// SIGNALR CLIENT
		// ==========================================
		const connection = new signalR.HubConnectionBuilder()
			.withUrl("/bookingHub")
			.withAutomaticReconnect()
			.build();

		connection.on("SlotStatusChanged", function(data) {
			const slotId = data.slotId;
			const status = data.status;
			const rowVersion = data.rowVersion;
			const btn = document.getElementById('slot-btn-' + slotId);
			if (!btn || btn.classList.contains('active')) return;

			if (rowVersion) {
				btn.setAttribute('data-row-version', rowVersion);
			}

			const label = btn.querySelector('.slot-status-label');
			if (status === 'Hold') {
				btn.className = 'btn w-100 py-2 slot-btn btn-light text-muted border disabled';
				btn.disabled = true;
				if (label) label.innerText = 'Người khác giữ';
			} else if (status === 'Booked') {
				btn.className = 'btn w-100 py-2 slot-btn btn-light text-muted border disabled';
				btn.disabled = true;
				if (label) label.innerText = 'Đã đặt';
			} else if (status === 'Open') {
				btn.className = 'btn w-100 py-2 slot-btn btn-outline-success';
				btn.disabled = false;
				if (label) label.innerText = 'Còn trống';
			}
		});

		connection.start().catch(err => console.warn("[SignalR] Error:", err.toString()));
	</script>
}