@model List<OCMSMVC.Models.DoctorScheduleItemViewModel>
@{
    ViewData["Title"] = "Quản lý Lịch trực Bác sĩ";
    string currentFilter = ViewBag.CurrentFilter as string ?? "today";
    int todayCount = ViewBag.TodayCount is int tc ? tc : 0;
    int upcomingCount = ViewBag.UpcomingCount is int uc ? uc : 0;
    int pastCount = ViewBag.PastCount is int pc ? pc : 0;
    int maxDays = ViewBag.MaxDays is int md ? md : 14;
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-week me-2"></i>Lịch trực & Khung giờ khám
            </h3>
            <p class="text-muted small mb-0">Chu kỳ đăng ký tối đa @maxDays ngày tới — Ca quá hạn tự động ẩn khỏi bảng nhưng lưu trữ vĩnh viễn trong CSDL</p>
        </div>
        <a asp-action="Register" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Đăng ký ca trực mới
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Nút điều hướng thời gian: Xem quá khứ | Hôm nay (Mặc định) | Xem tương lai -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="btn-group shadow-sm" role="group">
            <!-- 1. Nút Xem Quá Khứ -->
            <a asp-action="Index" asp-route-filter="past" class="btn @(currentFilter == "past" ? "btn-secondary" : "btn-outline-secondary")">
                <i class="bi bi-arrow-left me-1"></i>Xem ca quá khứ (@maxDays ngày trước)
                <span class="badge @(currentFilter == "past" ? "bg-light text-dark" : "bg-secondary text-white") ms-1">@pastCount</span>
            </a>

            <!-- 2. Nút Ca Hôm Nay (Mặc định) -->
            <a asp-action="Index" asp-route-filter="today" class="btn @(currentFilter == "today" ? "btn-primary" : "btn-outline-primary") fw-bold">
                <i class="bi bi-calendar-check me-1"></i>Hôm nay (@DateTime.Today.ToString("dd/MM/yyyy"))
                <span class="badge @(currentFilter == "today" ? "bg-white text-primary" : "bg-primary text-white") ms-1">@todayCount</span>
            </a>

            <!-- 3. Nút Xem Tương Lai -->
            <a asp-action="Index" asp-route-filter="upcoming" class="btn @(currentFilter == "upcoming" ? "btn-success" : "btn-outline-success")">
                Xem ca tương lai (@maxDays ngày tới)<i class="bi bi-arrow-right ms-1"></i>
                <span class="badge @(currentFilter == "upcoming" ? "bg-light text-dark" : "bg-success text-white") ms-1">@upcomingCount</span>
            </a>
        </div>

        <span class="text-muted small">
            Đang xem: 
            <strong>
                @(currentFilter switch {
                    "past" => $"Lịch sử {maxDays} ngày gần nhất",
                    "upcoming" => $"Ca làm việc trong {maxDays} ngày tới",
                    _ => "Ca trực ngày hôm nay"
                })
            </strong>
        </span>
    </div>

    <!-- Bảng hiển thị danh sách ca -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 d-block mb-3"></i>
                    @if (currentFilter == "today")
                    {
                        <p class="mb-2 fs-6">Hôm nay bạn không có ca trực nào.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Index" asp-route-filter="upcoming" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-arrow-right me-1"></i>Xem ca tương lai (@upcomingCount)
                            </a>
                            <a asp-action="Register" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>Đăng ký ca trực mới
                            </a>
                        </div>
                    }
                    else if (currentFilter == "upcoming")
                    {
                        <p class="mb-2">Không có ca trực nào được đăng ký trong @maxDays ngày tới.</p>
                        <a asp-action="Register" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Đăng ký ca trực mới
                        </a>
                    }
                    else
                    {
                        <p class="mb-0">Không có ca trực nào trong @maxDays ngày vừa qua.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Ngày làm việc</th>
                                <th>Ca trực</th>
                                <th>Phòng khám</th>
                                <th class="text-center">Số Slot (15p)</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                bool isPast = s.WorkDate.Date < DateTime.Today;
                                <tr class="@(isPast ? "text-muted" : "")">
                                    <td class="ps-3 fw-medium">
                                        <div class="d-flex align-items-center">
                                            <div class="calendar-badge me-2 text-center p-1 bg-light rounded border" style="min-width: 48px;">
                                                <small class="d-block text-uppercase text-muted" style="font-size: 0.7rem;">Tháng @s.WorkDate.Month</small>
                                                <strong class="fs-6">@s.WorkDate.Day</strong>
                                            </div>
                                            <div>
                                                <div>
                                                    @s.WorkDate.ToString("dd/MM/yyyy")
                                                    @if (s.WorkDate.Date == DateTime.Today)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Hôm nay</span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    @{
                                                        string dayOfWeekStr = s.WorkDate.DayOfWeek switch
                                                        {
                                                            DayOfWeek.Monday => "Thứ Hai",
                                                            DayOfWeek.Tuesday => "Thứ Ba",
                                                            DayOfWeek.Wednesday => "Thứ Tư",
                                                            DayOfWeek.Thursday => "Thứ Năm",
                                                            DayOfWeek.Friday => "Thứ Sáu",
                                                            DayOfWeek.Saturday => "Thứ Bảy",
                                                            DayOfWeek.Sunday => "Chủ Nhật",
                                                            _ => ""
                                                        };
                                                    }
                                                    @dayOfWeekStr
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (s.ShiftType == "Morning")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-sun me-1"></i>Sáng (07:30 - 11:30)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-sunset me-1"></i>Chiều (13:00 - 17:00)</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-secondary">
                                            <i class="bi bi-door-closed me-1"></i>Phòng @s.RoomNumber
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(s.BookedSlotsCount > 0 ? "bg-primary" : "bg-secondary")">
                                            @s.BookedSlotsCount / @s.MaxQuota đã đặt
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (isPast)
                                        {
                                            <span class="badge bg-secondary">Đã kết thúc</span>
                                        }
                                        else if (s.Status == "Active")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-info me-1" data-bs-toggle="modal" data-bs-target="#slotsModal-@s.Id">
                                            <i class="bi bi-clock-history me-1"></i>16 Slot
                                        </button>
                                        @if (s.CanCancel)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@s.Id">
                                                <i class="bi bi-calendar-x me-1"></i>Hủy ca
                                            </button>
                                        }
                                        else if (s.Status == "Active" && s.BookedSlotsCount > 0 && !isPast)
                                        {
                                            <span class="badge bg-light text-muted border">
                                                <i class="bi bi-lock-fill me-1"></i>Đã có hẹn
                                            </span>
                                        }
                                    </td>
                                </tr>

                                <!-- Modal Chi tiết 16 Slot -->
                                <div class="modal fade" id="slotsModal-@s.Id" tabindex="-1" aria-labelledby="slotsModalLabel-@s.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header bg-light">
                                                <h6 class="modal-title fw-bold" id="slotsModalLabel-@s.Id">
                                                    <i class="bi bi-clock me-1 text-primary"></i>Chi tiết 16 Slot Khám — @s.WorkDate.ToString("dd/MM/yyyy") (@s.ShiftDisplayName)
                                                </h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row g-2">
                                                    @foreach (var slot in s.TimeSlots)
                                                    {
                                                        <div class="col-6 col-md-3">
                                                            <div class="p-2 border rounded text-center @(slot.Status == "Open" ? "border-success bg-success-subtle text-success" : (slot.Status == "Booked" ? "border-primary bg-primary-subtle text-primary" : "border-secondary bg-light text-muted"))">
                                                                <small class="d-block fw-bold">@slot.TimeDisplay</small>
                                                                <span class="badge @(slot.Status == "Open" ? "bg-success" : (slot.Status == "Booked" ? "bg-primary" : "bg-secondary"))" style="font-size: 0.7rem;">
                                                                    @(slot.Status == "Open" ? "Trống (Open)" : (slot.Status == "Booked" ? "Đã đặt (Booked)" : slot.Status))
                                                                </span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Modal Xác nhận Hủy Ca Trực -->
                                @if (s.CanCancel)
                                {
                                    <div class="modal fade" id="cancelModal-@s.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="Cancel" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <div class="modal-header bg-danger text-white">
                                                        <h6 class="modal-title fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận Hủy Ca Trực Khẩn Cấp
                                                        </h6>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-2">Bạn có chắc chắn muốn hủy ca trực sau vì lý do cá nhân / khẩn cấp?</p>
                                                        <div class="p-3 bg-light rounded border mb-3">
                                                            <div><strong>Ngày:</strong> @s.WorkDate.ToString("dd/MM/yyyy")</div>
                                                            <div><strong>Ca:</strong> @s.ShiftDisplayName</div>
                                                            <div><strong>Phòng:</strong> Phòng @s.RoomNumber</div>
                                                            <div><strong>Tình trạng:</strong> Chưa có bệnh nhân đặt hẹn (0/@s.MaxQuota)</div>
                                                        </div>
                                                        <small class="text-danger d-block">
                                                            <i class="bi bi-info-circle me-1"></i>Sau khi hủy, tất cả 16 slot khám của ca này sẽ đóng lại và không nhận lịch hẹn nữa.
                                                        </small>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Không hủy</button>
                                                        <button type="submit" class="btn btn-danger btn-sm">
                                                            <i class="bi bi-trash me-1"></i>Xác nhận Hủy Ca
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
