@model List<OCMSMVC.Models.DoctorScheduleItemViewModel>
@{
    ViewData["Title"] = "Lịch trực Bác sĩ";
    DateTime viewDate = ViewBag.ViewDate is DateTime vd ? vd : DateTime.Today;
    DateTime today = ViewBag.Today is DateTime td ? td : DateTime.Today;
    string prevDate = ViewBag.PrevDate as string ?? viewDate.AddDays(-1).ToString("yyyy-MM-dd");
    string nextDate = ViewBag.NextDate as string ?? viewDate.AddDays(1).ToString("yyyy-MM-dd");
    string? firstDate = ViewBag.FirstDate as string;
    string? lastDate = ViewBag.LastDate as string;
    string windowStart = ViewBag.WindowStart as string ?? today.AddDays(-14).ToString("yyyy-MM-dd");
    string windowEnd = ViewBag.WindowEnd as string ?? today.AddDays(14).ToString("yyyy-MM-dd");

    bool atWindowStart = viewDate.ToString("yyyy-MM-dd") == windowStart;
    bool atWindowEnd = viewDate.ToString("yyyy-MM-dd") == windowEnd;

    string[] days = { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
    string dayLabel = days[(int)viewDate.DayOfWeek];
    bool isToday = viewDate.Date == today.Date;
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h4 class="fw-bold mb-0">Lịch trực bác sĩ</h4>
        <a asp-action="Register" class="btn btn-primary btn-sm">Đăng ký ca trực</a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Điều hướng ngày -->
    <div class="d-flex justify-content-center align-items-center gap-1 mb-3">
        @if (firstDate != null && viewDate.ToString("yyyy-MM-dd") != firstDate)
        {
            <a asp-action="Index" asp-route-date="@firstDate" class="btn btn-sm btn-outline-secondary" title="Đến ngày đầu tiên">&laquo;</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary" disabled>&laquo;</button>
        }

        @if (!atWindowStart)
        {
            <a asp-action="Index" asp-route-date="@prevDate" class="btn btn-sm btn-outline-secondary" title="Ngày trước">&lsaquo;</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary" disabled>&lsaquo;</button>
        }

        <div class="px-3 py-1 border rounded bg-white text-center" style="min-width: 180px;">
            <span class="fw-bold @(isToday ? "text-primary" : "")">
                @dayLabel, @viewDate.ToString("dd/MM/yyyy")
            </span>
            @if (isToday)
            {
                <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">Hôm nay</span>
            }
        </div>

        @if (!atWindowEnd)
        {
            <a asp-action="Index" asp-route-date="@nextDate" class="btn btn-sm btn-outline-secondary" title="Ngày sau">&rsaquo;</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary" disabled>&rsaquo;</button>
        }

        @if (lastDate != null && viewDate.ToString("yyyy-MM-dd") != lastDate)
        {
            <a asp-action="Index" asp-route-date="@lastDate" class="btn btn-sm btn-outline-secondary" title="Đến ngày cuối cùng">&raquo;</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary" disabled>&raquo;</button>
        }

        @if (!isToday)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-primary ms-2">Hôm nay</a>
        }
    </div>

    <!-- Bảng danh sách ca trực -->
    <div class="card border">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    Không có ca trực nào vào ngày này.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Ngày làm việc</th>
                                <th>Ca trực</th>
                                <th>Phòng khám</th>
                                <th class="text-center">Số lượt đặt</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                bool isPast = s.WorkDate.Date < DateTime.Today;
                                <tr class="@(isPast ? "text-muted" : "")">
                                    <td class="ps-3">
                                        <div class="fw-semibold">@s.WorkDate.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@s.WorkDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</small>
                                    </td>
                                    <td>
                                        @if (s.ShiftType == "Morning")
                                        {
                                            <span class="badge bg-warning text-dark">Sáng (07:30 - 11:30)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Chiều (13:00 - 17:00)</span>
                                        }
                                    </td>
                                    <td>Phòng @s.RoomNumber</td>
                                    <td class="text-center">
                                        <span class="badge @(s.BookedSlotsCount > 0 ? "bg-primary" : "bg-secondary")">
                                            @s.BookedSlotsCount / @s.MaxQuota
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (isPast)
                                        {
                                            <span class="badge bg-secondary">Kết thúc</span>
                                        }
                                        else if (s.Status == "Active")
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#slotsModal-@s.Id">
                                            Xem 16 slot
                                        </button>
                                        @if (s.CanCancel)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@s.Id">
                                                Hủy ca
                                            </button>
                                        }
                                        else if (s.Status == "Active" && s.BookedSlotsCount > 0 && !isPast)
                                        {
                                            <span class="badge bg-light text-muted border">Có lịch hẹn</span>
                                        }
                                    </td>
                                </tr>

                                <!-- Modal Chi tiết 16 Slot -->
                                <div class="modal fade" id="slotsModal-@s.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h6 class="modal-title fw-bold">
                                                    Danh sách 16 Slot - @s.WorkDate.ToString("dd/MM/yyyy") (@s.ShiftDisplayName)
                                                </h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row g-2">
                                                    @foreach (var slot in s.TimeSlots)
                                                    {
                                                        <div class="col-6 col-md-3">
                                                            <div class="p-2 border rounded text-center @(slot.Status == "Open" ? "border-success bg-light text-success" : (slot.Status == "Booked" ? "border-primary bg-light text-primary" : "border-secondary bg-light text-muted"))">
                                                                <div class="fw-bold small">@slot.TimeDisplay</div>
                                                                <span class="badge @(slot.Status == "Open" ? "bg-success" : (slot.Status == "Booked" ? "bg-primary" : "bg-secondary"))" style="font-size: 0.65rem;">
                                                                    @(slot.Status == "Open" ? "Trống" : (slot.Status == "Booked" ? "Đã đặt" : slot.Status))
                                                                </span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="modal-footer py-1">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Modal Xác nhận Hủy Ca Trực -->
                                @if (s.CanCancel)
                                {
                                    <div class="modal fade" id="cancelModal-@s.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="Cancel" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <input type="hidden" name="date" value="@viewDate.ToString("yyyy-MM-dd")" />
                                                    <div class="modal-header">
                                                        <h6 class="modal-title fw-bold text-danger">Xác nhận hủy ca trực</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-2">Bạn có chắc chắn muốn hủy ca trực này?</p>
                                                        <div class="p-2 bg-light rounded border small">
                                                            <div><strong>Ngày:</strong> @s.WorkDate.ToString("dd/MM/yyyy")</div>
                                                            <div><strong>Ca:</strong> @s.ShiftDisplayName</div>
                                                            <div><strong>Phòng:</strong> Phòng @s.RoomNumber</div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer py-1">
                                                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-sm btn-danger">Hủy ca</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
