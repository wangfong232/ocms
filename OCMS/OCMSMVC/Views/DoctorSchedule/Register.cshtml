@model OCMSMVC.Models.RegisterShiftViewModel
@{
    ViewData["Title"] = "Đăng ký ca trực";
    var minDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Header -->
            <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Quay lại</a>
                <h4 class="fw-bold mb-0">Đăng ký ca trực</h4>
            </div>

            <!-- Card Form -->
            <div class="card border">
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <!-- 1. Ngày làm việc -->
                        <div class="mb-3">
                            <label asp-for="WorkDate" class="form-label fw-semibold">Ngày làm việc <span class="text-danger">*</span></label>
                            <input asp-for="WorkDate" class="form-control" type="date" min="@minDate" />
                            <span asp-validation-for="WorkDate" class="text-danger small"></span>
                        </div>

                        <!-- 2. Ca trực -->
                        <div class="mb-3">
                            <label asp-for="ShiftType" class="form-label fw-semibold">Ca trực <span class="text-danger">*</span></label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded @(Model.ShiftType == "Morning" ? "border-primary bg-light" : "")">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="ShiftType" value="Morning" id="shiftMorning" checked />
                                        <label class="form-check-label fw-semibold" for="shiftMorning">
                                            Ca Sáng
                                            <div class="small text-muted fw-normal">07:30 - 11:30 (16 slot)</div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded @(Model.ShiftType == "Afternoon" ? "border-primary bg-light" : "")">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="ShiftType" value="Afternoon" id="shiftAfternoon" />
                                        <label class="form-check-label fw-semibold" for="shiftAfternoon">
                                            Ca Chiều
                                            <div class="small text-muted fw-normal">13:00 - 17:00 (16 slot)</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ShiftType" class="text-danger small"></span>
                        </div>

                        <!-- 3. Phòng khám -->
                        <div class="mb-4">
                            <label asp-for="RoomId" class="form-label fw-semibold">Phòng khám <span class="text-danger">*</span></label>
                            <select asp-for="RoomId" class="form-select">
                                @if (Model.AvailableRooms != null && Model.AvailableRooms.Any())
                                {
                                    @foreach (var room in Model.AvailableRooms)
                                    {
                                        <option value="@room.Id" selected="@(room.Id == Model.RoomId ? "selected" : null)">
                                            Phòng @room.RoomNumber @(room.Id == Model.RoomId ? "(Mặc định)" : "")
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="">Không có phòng khám khả dụng</option>
                                }
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4">Đăng ký ca trực</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
