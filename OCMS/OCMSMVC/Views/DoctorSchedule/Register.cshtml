@model OCMSMVC.Models.RegisterShiftViewModel
@{
    ViewData["Title"] = "Đăng ký Ca trực Tuần";
    var minDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                <div>
                    <h3 class="fw-bold text-primary mb-1">
                        <i class="bi bi-calendar-plus me-2"></i>Đăng ký Ca trực Tuần
                    </h3>
                    <p class="text-muted small mb-0">Hệ thống sẽ tự động tạo 16 slot khám (15 phút/slot) cho ca trực</p>
                </div>
            </div>

            <!-- Card Form -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- 1. Ngày làm việc -->
                        <div class="mb-3">
                            <label asp-for="WorkDate" class="form-label fw-semibold">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Ngày làm việc <span class="text-danger">*</span>
                            </label>
                            <input asp-for="WorkDate" class="form-control" type="date" min="@minDate" />
                            <span asp-validation-for="WorkDate" class="text-danger small"></span>
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>Theo quy định phòng khám, ca trực phải đăng ký trước ít nhất <strong>24 giờ</strong>.
                            </div>
                        </div>

                        <!-- 2. Ca trực -->
                        <div class="mb-3">
                            <label asp-for="ShiftType" class="form-label fw-semibold">
                                <i class="bi bi-clock me-1 text-primary"></i>Ca trực <span class="text-danger">*</span>
                            </label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded @(Model.ShiftType == "Morning" ? "border-primary bg-light" : "")">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="ShiftType" value="Morning" id="shiftMorning" checked />
                                        <label class="form-check-label fw-medium" for="shiftMorning">
                                            <i class="bi bi-sun text-warning me-1"></i>Ca Sáng
                                            <div class="small text-muted fw-normal">07:30 - 11:30 (16 slots x 15 phút)</div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded @(Model.ShiftType == "Afternoon" ? "border-primary bg-light" : "")">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="ShiftType" value="Afternoon" id="shiftAfternoon" />
                                        <label class="form-check-label fw-medium" for="shiftAfternoon">
                                            <i class="bi bi-sunset text-info me-1"></i>Ca Chiều
                                            <div class="small text-muted fw-normal">13:00 - 17:00 (16 slots x 15 phút)</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ShiftType" class="text-danger small"></span>
                        </div>

                        <!-- 3. Phòng khám -->
                        <div class="mb-4">
                            <label asp-for="RoomId" class="form-label fw-semibold">
                                <i class="bi bi-door-closed me-1 text-primary"></i>Phòng khám <span class="text-danger">*</span>
                            </label>
                            <select asp-for="RoomId" class="form-select">
                                @if (Model.AvailableRooms != null && Model.AvailableRooms.Any())
                                {
                                    @foreach (var room in Model.AvailableRooms)
                                    {
                                        <option value="@room.Id" selected="@(room.Id == Model.RoomId ? "selected" : null)">
                                            Phòng @room.RoomNumber @(room.Id == Model.RoomId ? "(Phòng khám mặc định)" : "")
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="">Không có phòng khám khả dụng</option>
                                }
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                            <div class="form-text text-muted">
                                Hệ thống đã tự động chọn sẵn phòng mặc định được phân công của bạn. Bạn có thể chọn phòng khác nếu cần.
                            </div>
                        </div>

                        <!-- Card tóm tắt tự động tạo 16 slot -->
                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h6 class="fw-bold text-secondary mb-2">
                                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Cơ chế tự động sinh Slot (Slot Generation):
                                </h6>
                                <ul class="small text-muted mb-0 ps-3">
                                    <li>Mỗi ca trực có tổng cộng <strong>16 khung giờ khám</strong> độc lập (mỗi khung 15 phút).</li>
                                    <li>Tất cả 16 khung giờ ban đầu sẽ ở trạng thái <strong>Mở (Open)</strong> để bệnh nhân có thể đặt lịch khám.</li>
                                    <li>Hệ thống áp dụng cơ chế khóa Concurrency Token (`RowVersion`) để bảo vệ chống trùng lịch millisecond.</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Xác nhận Đăng ký Ca trực
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

