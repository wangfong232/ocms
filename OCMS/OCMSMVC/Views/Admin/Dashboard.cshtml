@model OCMSMVC.Models.AdminDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Thống Kê Doanh Thu & Vận Hành";
}

<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

<div class="container-fluid py-4 px-md-4">
    <!-- Header & Date Filter -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary fw-semibold px-3 py-1 mb-2 rounded-pill">
                <i class="bi bi-graph-up me-1"></i> Báo Cáo Tài Chính & Hiệu Suất
            </div>
            <h2 class="fw-bold text-dark mb-0">Thống Kê Doanh Thu & Vận Hành</h2>
        </div>
        
        <div class="bg-white border rounded-pill shadow-sm px-3 py-2 mt-2 mt-md-0 d-flex align-items-center" id="reportrange" style="cursor: pointer;">
            <i class="bi bi-calendar-range text-primary me-2"></i>
            <span class="fw-semibold text-dark small">@Model.StartDate - @Model.EndDate</span> 
            <i class="bi bi-chevron-down ms-2 text-muted small"></i>
        </div>
    </div>

    <!-- 4 KPI Metrics Cards -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Doanh thu -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-4 p-3 bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Tổng Doanh Thu</span>
                    <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-primary mb-1">@Model.TotalRevenue.ToString("N0") đ</h3>
                <small class="text-muted">Doanh thu khám, xét nghiệm & thuốc</small>
            </div>
        </div>

        <!-- KPI 2: Bệnh nhân -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-4 p-3 bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Tổng Bệnh Nhân</span>
                    <div class="p-2 rounded-3 bg-success-subtle text-success">
                        <i class="bi bi-person-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-1">@Model.TotalPatients</h3>
                <small class="text-muted">Bệnh nhân độc bản trong kỳ</small>
            </div>
        </div>

        <!-- KPI 3: Lượt khám -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-4 p-3 bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Tổng Lượt Khám</span>
                    <div class="p-2 rounded-3 bg-info-subtle text-info">
                        <i class="bi bi-calendar2-week fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-info mb-1">@Model.TotalAppointments</h3>
                <small class="text-muted">Lịch hẹn hoàn tất & xác nhận</small>
            </div>
        </div>

        <!-- KPI 4: Tỷ lệ hủy -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-4 p-3 bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Tỷ Lệ Hủy Lịch</span>
                    <div class="p-2 rounded-3 bg-danger-subtle text-danger">
                        <i class="bi bi-x-octagon fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-danger mb-1">@Model.CancellationRate %</h3>
                <small class="text-muted">Lịch hẹn bệnh nhân chủ động hủy</small>
            </div>
        </div>
    </div>

    <!-- Charts & Rankings Row -->
    <div class="row g-4">
        <!-- Cột trái: Biểu đồ xu hướng doanh thu -->
        <div class="col-xl-7 col-lg-7">
            <div class="card border rounded-4 shadow-sm h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Biến Động Doanh Thu</h5>
                        <small class="text-muted">Theo ngày / tháng trong khoảng thời gian chọn</small>
                    </div>
                    <span class="badge bg-light text-primary border px-2 py-1 small">Doanh thu VNĐ</span>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <div class="flex-grow-1" style="position: relative; min-height: 420px;">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: 24h hôm nay + Xếp hạng Khoa & Bác sĩ -->
        <div class="col-xl-5 col-lg-5">
            <!-- Biểu đồ 24h -->
            <div class="card border rounded-4 shadow-sm mb-4 bg-white">
                <div class="card-header bg-white border-0 pt-3 px-3 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-success me-1"></i> Doanh Thu Hôm Nay (24h)</h6>
                    <span class="badge bg-success-subtle text-success small">Theo giờ</span>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 180px;">
                        <canvas id="todayHourlyChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Bảng xếp hạng Khoa & Bác sĩ -->
            <div class="row g-3">
                <!-- Bảng xếp hạng Khoa -->
                <div class="col-sm-6">
                    <div class="card border rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-header bg-white border-0 pt-3 px-3 pb-2">
                            <h6 class="fw-bold mb-0 text-dark small"><i class="bi bi-trophy-fill text-warning me-1"></i> Khoa Doanh Thu Cao</h6>
                        </div>
                        <div class="card-body p-2 pt-0">
                            <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <tbody>
                                        @{
                                            int rankDept = 1;
                                            foreach (var item in Model.RevenueByDepartment.OrderByDescending(x => x.Value))
                                            {
                                                <tr class="border-bottom">
                                                    <td class="text-center py-2" style="width: 32px;">
                                                        @if (rankDept == 1) { <span class="badge bg-warning text-dark rounded-circle px-2 py-1">1</span> }
                                                        else if (rankDept == 2) { <span class="badge bg-secondary text-white rounded-circle px-2 py-1">2</span> }
                                                        else if (rankDept == 3) { <span class="badge bg-light text-dark border rounded-circle px-2 py-1">3</span> }
                                                        else { <span class="text-muted small">@rankDept</span> }
                                                    </td>
                                                    <td class="fw-semibold text-dark py-2 small">@item.Key</td>
                                                    <td class="text-end fw-bold text-primary py-2 small">@item.Value.ToString("N0") đ</td>
                                                </tr>
                                                rankDept++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Bảng xếp hạng Bác sĩ -->
                <div class="col-sm-6">
                    <div class="card border rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-header bg-white border-0 pt-3 px-3 pb-2">
                            <h6 class="fw-bold mb-0 text-dark small"><i class="bi bi-person-fill-check text-info me-1"></i> Bác Sĩ Hàng Đầu</h6>
                        </div>
                        <div class="card-body p-2 pt-0">
                            <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <tbody>
                                        @{
                                            int rankDoc = 1;
                                            foreach (var item in Model.RevenueByDoctor.OrderByDescending(x => x.Value))
                                            {
                                                <tr class="border-bottom">
                                                    <td class="text-center py-2" style="width: 32px;">
                                                        @if (rankDoc == 1) { <span class="badge bg-primary text-white rounded-circle px-2 py-1">1</span> }
                                                        else if (rankDoc == 2) { <span class="badge bg-secondary text-white rounded-circle px-2 py-1">2</span> }
                                                        else if (rankDoc == 3) { <span class="badge bg-light text-dark border rounded-circle px-2 py-1">3</span> }
                                                        else { <span class="text-muted small">@rankDoc</span> }
                                                    </td>
                                                    <td class="fw-semibold text-dark py-2 small">@item.Key</td>
                                                    <td class="text-end fw-bold text-primary py-2 small">@item.Value.ToString("N0") đ</td>
                                                </tr>
                                                rankDoc++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    
    <script>
        $(function() {
            var start = moment('@Model.StartDate', 'DD/MM/YYYY');
            var end = moment('@Model.EndDate', 'DD/MM/YYYY');

            $('#reportrange').daterangepicker({
            startDate: start,
            endDate: end,
            showDropdowns: true, 
            linkedCalendars: false,
            minYear: 2020, 
            maxYear: parseInt(moment().format('YYYY'), 10) + 1, 
            ranges: {
               'Hôm nay': [moment(), moment()],
               'Hôm qua': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
               '7 ngày qua': [moment().subtract(6, 'days'), moment()],
               '30 ngày qua': [moment().subtract(29, 'days'), moment()],
               'Tháng này': [moment().startOf('month'), moment().endOf('month')],
               'Tháng trước': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
               'Năm nay': [moment().startOf('year'), moment().endOf('year')], 
               'Năm trước': [moment().subtract(1, 'year').startOf('year'), moment().subtract(1, 'year').endOf('year')]
            },
            locale: { 
                format: 'DD/MM/YYYY', 
                customRangeLabel: "Tùy chọn",
                applyLabel: "Áp dụng",
                cancelLabel: "Đóng",
                daysOfWeek: ["CN", "T2", "T3", "T4", "T5", "T6", "T7"],
                monthNames: ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"]
            }
        }, function(start, end) {
            window.location.href = '?startDate=' + start.format('YYYY-MM-DD') + '&endDate=' + end.format('YYYY-MM-DD');
        });
        });

        const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByMonth.Keys));
        const trendData = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByMonth.Values));

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Doanh thu (VNĐ)',
                        data: trendData,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }
                ]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false, 
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        const todayHours = @Html.Raw(JsonSerializer.Serialize(Model.TodayHourLabels));
        const todayRevenues = @Html.Raw(JsonSerializer.Serialize(Model.TodayHourlyRevenue));

        new Chart(document.getElementById('todayHourlyChart'), {
            type: 'bar',
            data: {
                labels: todayHours,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: todayRevenues,
                    backgroundColor: '#20c997',
                    borderRadius: 3,
                    barPercentage: 0.7
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }, 
                scales: { 
                    y: { display: true, beginAtZero: true },
                    x: { ticks: { maxTicksLimit: 12 } }
                } 
            }
        });
    </script>
}