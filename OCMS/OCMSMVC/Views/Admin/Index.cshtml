@model OCMSMVC.Models.AdminDashboardViewModel
@{ 
    ViewData["Title"] = "Quản trị phòng khám"; 
}

<div class="container py-4">
    <div class="mb-5 text-center">
        <p class="text-uppercase text-primary fw-bold small mb-2"><i class="bi bi-shield-lock me-2"></i>Hệ Thống Quản Trị</p>
        <h1 class="display-5 fw-bold text-dark">Tổng Quan Phòng Khám</h1>
    </div>

    @if (TempData["ErrorMessage"] is string error) 
    { 
        <div class="alert alert-danger shadow-sm border-0 mb-4">@error</div> 
    }
    @if (TempData["SuccessMessage"] is string success) 
    { 
        <div class="alert alert-success shadow-sm border-0 mb-4">@success</div> 
    }

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <a class="card h-100 text-decoration-none shadow border-0 bg-white p-4 border-bottom border-danger border-5" asp-action="Dashboard">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-muted fw-semibold mb-1">Thống Kê Doanh Thu</h5>
                        <h3 class="fw-bold text-dark mb-0 mt-2">Biểu đồ & Báo cáo</h3>
                    </div>
                    <div class="display-4 text-danger opacity-50">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>
                </div>
                <div class="text-muted mt-3">
                    Xem phân tích doanh thu và lượt khám chi tiết &rarr;
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a class="card h-100 text-decoration-none shadow border-0 bg-white p-4 border-bottom border-success border-5" asp-action="Users">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-muted fw-semibold mb-1">Tài Khoản & Nhân Sự</h5>
                        <h1 class="display-4 fw-bold text-dark mb-0">@Model.Users.Count</h1>
                    </div>
                    <div class="display-4 text-success opacity-50">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="text-muted mt-3">
                    Quản lý bác sĩ, nhân viên và trạng thái truy cập &rarr;
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a class="card h-100 text-decoration-none shadow border-0 bg-white p-4 border-bottom border-warning border-5" asp-action="Departments">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-muted fw-semibold mb-1">Chuyên Khoa Khám</h5>
                        <h1 class="display-4 fw-bold text-dark mb-0">@Model.Departments.Count</h1>
                    </div>
                    <div class="display-4 text-warning opacity-50">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                </div>
                <div class="text-muted mt-3">
                    Cấu hình danh mục khoa và phí khám cơ bản &rarr;
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a class="card h-100 text-decoration-none shadow border-0 bg-white p-4 border-bottom border-info border-5" asp-action="Rooms">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-muted fw-semibold mb-1">Phòng Khám</h5>
                        <h1 class="display-4 fw-bold text-dark mb-0">@Model.Rooms.Count</h1>
                    </div>
                    <div class="display-4 text-info opacity-50">
                        <i class="bi bi-door-closed"></i>
                    </div>
                </div>
                <div class="text-muted mt-3">
                    Quản lý danh sách phòng và trạng thái hoạt động &rarr;
                </div>
            </a>
        </div>

    </div>

    <div class="alert alert-secondary border-0 shadow-sm text-center">
        <i class="bi bi-info-circle me-2"></i> Tài khoản bác sĩ được tạo cùng hồ sơ bác sĩ. Tài khoản bệnh nhân được đăng ký qua trang dành cho khách.
    </div>
</div>