@model OCMSMVC.Models.DoctorProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ & Biểu phí Bác sĩ";
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-badge me-2"></i>Hồ sơ Chuyên môn & Biểu phí Khám
            </h3>
            <p class="text-muted small mb-0">Cập nhật chức danh, phòng khám mặc định và giá khám mỗi lượt (PricePerSlot)</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-people me-1"></i>Danh sách Bác sĩ
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Form cập nhật hồ sơ & phí khám -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-semibold text-secondary">
                        <i class="bi bi-pencil-square me-2"></i>Thông tin chi tiết
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DoctorId" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="DepartmentId" />
                        <input type="hidden" asp-for="DepartmentName" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="IsAdminEditing" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- 1. Chuyên khoa & Email (Readonly) -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Chuyên khoa</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-hospital"></i></span>
                                    <input type="text" class="form-control bg-light" value="@Model.DepartmentName" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Địa chỉ Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                                </div>
                            </div>
                        </div>

                        <!-- 2. Học hàm / Học vị (Academic Title) -->
                        <div class="mb-3">
                            <label asp-for="AcademicTitle" class="form-label fw-semibold">
                                <i class="bi bi-mortarboard me-1 text-primary"></i>Học hàm / Học vị <span class="text-danger">*</span>
                            </label>
                            <select asp-for="AcademicTitle" class="form-select" id="academicTitleSelect">
                                <option value="BS">BS — Bác sĩ Đa khoa / Chuyên khoa</option>
                                <option value="ThS.BS">ThS.BS — Thạc sĩ Bác sĩ</option>
                                <option value="BSCK1">BSCK1 — Bác sĩ Chuyên khoa 1</option>
                                <option value="BSCK2">BSCK2 — Bác sĩ Chuyên khoa 2</option>
                                <option value="TS.BS">TS.BS — Tiến sĩ Bác sĩ</option>
                                <option value="PGS.TS.BS">PGS.TS.BS — Phó Giáo sư Tiến sĩ Bác sĩ</option>
                            </select>
                            <span asp-validation-for="AcademicTitle" class="text-danger small"></span>
                        </div>

                        <!-- 3. Họ và tên Bác sĩ -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">
                                <i class="bi bi-person me-1 text-primary"></i>Họ và tên bác sĩ <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" id="fullNameInput" placeholder="Ví dụ: Nguyễn Văn An" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- 4. Số điện thoại -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1 text-primary"></i>Số điện thoại liên hệ <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- 5. Giá khám mỗi slot (PricePerSlot) -->
                        <div class="mb-3">
                            <label asp-for="PricePerSlot" class="form-label fw-semibold">
                                <i class="bi bi-cash-coin me-1 text-success"></i>Giá khám mỗi lượt (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="PricePerSlot" class="form-control" id="priceInput" type="number" step="5000" min="0" />
                                <span class="input-group-text">VNĐ / 15 phút</span>
                            </div>
                            <span asp-validation-for="PricePerSlot" class="text-danger small"></span>
                            <div class="form-text text-muted">
                                Biểu phí khám bệnh công khai để bệnh nhân nắm rõ khi chọn bác sĩ và đặt lịch.
                            </div>
                        </div>

                        <!-- 6. Phòng khám mặc định -->
                        <div class="mb-4">
                            <label asp-for="DefaultRoomId" class="form-label fw-semibold">
                                <i class="bi bi-door-closed me-1 text-primary"></i>Phòng khám mặc định
                            </label>
                            <select asp-for="DefaultRoomId" class="form-select" id="roomSelect">
                                <option value="">-- Chưa chỉ định phòng mặc định --</option>
                                @foreach (var r in Model.AvailableRooms)
                                {
                                    <option value="@r.Id" selected="@(r.Id == Model.DefaultRoomId ? "selected" : null)">
                                        Phòng @r.RoomNumber
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="DefaultRoomId" class="text-danger small"></span>
                            <div class="form-text text-muted">
                                Phòng khám này sẽ tự động điền sẵn khi đăng ký ca trực tuần.
                            </div>
                        </div>

                        <!-- Submit button -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i>Lưu thông tin & Biểu phí
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Preview Card: Thẻ danh thiếp Bác sĩ hiển thị cho Bệnh nhân -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-semibold text-center">
                        <i class="bi bi-eye me-2"></i>Xem trước Thẻ Bác sĩ
                    </h5>
                    <small class="d-block text-center text-white-50">Hình ảnh hiển thị với Bệnh nhân khi đặt lịch khám</small>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="avatar-wrapper mb-3 mx-auto">
                        <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 90px; height: 90px;">
                            <i class="bi bi-person-fill-gear fs-1"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold mb-1" id="previewFullName">
                        <span id="previewTitle" class="badge bg-secondary me-1">@Model.AcademicTitle</span>
                        <span>@Model.FullName</span>
                    </h4>

                    <p class="text-primary fw-medium mb-2">
                        <i class="bi bi-hospital me-1"></i>@Model.DepartmentName
                    </p>

                    <div class="d-inline-block p-2 px-3 bg-light rounded-pill border mb-3">
                        <span class="text-muted small">Phòng khám: </span>
                        <strong class="text-dark" id="previewRoom">
                            @{
                                var currentRoom = Model.AvailableRooms.FirstOrDefault(r => r.Id == Model.DefaultRoomId);
                            }
                            @(currentRoom != null ? $"Phòng {currentRoom.RoomNumber}" : "Chưa xếp phòng")
                        </strong>
                    </div>

                    <hr />

                    <div class="p-3 bg-success-subtle rounded-3 border border-success text-center">
                        <span class="text-success small fw-semibold text-uppercase d-block mb-1">
                            <i class="bi bi-shield-check me-1"></i>Biểu phí khám niêm yết
                        </span>
                        <h3 class="fw-bold text-success mb-0" id="previewPrice">
                            @Model.PricePerSlot.ToString("N0") đ
                        </h3>
                        <small class="text-muted">/ 15 phút tư vấn & khám lâm sàng</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview danh thiếp Bác sĩ
        document.getElementById('fullNameInput').addEventListener('input', function() {
            document.querySelector('#previewFullName span:last-child').innerText = this.value || 'Chưa nhập tên';
        });

        document.getElementById('academicTitleSelect').addEventListener('change', function() {
            document.getElementById('previewTitle').innerText = this.value;
        });

        document.getElementById('priceInput').addEventListener('input', function() {
            var val = parseFloat(this.value) || 0;
            document.getElementById('previewPrice').innerText = val.toLocaleString('vi-VN') + ' đ';
        });

        document.getElementById('roomSelect').addEventListener('change', function() {
            var selectedText = this.options[this.selectedIndex].text;
            if (this.value) {
                document.getElementById('previewRoom').innerText = selectedText;
            } else {
                document.getElementById('previewRoom').innerText = 'Chưa xếp phòng';
            }
        });
    </script>
}

