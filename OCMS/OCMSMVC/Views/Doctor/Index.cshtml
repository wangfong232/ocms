@model List<OCMSMVC.Models.DoctorListItemViewModel>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Đội ngũ Bác sĩ & Biểu phí Khám";
    var userRole = Context.Session.GetString("Role");
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-people me-2"></i>Đội ngũ Bác sĩ & Biểu phí Niêm yết
            </h3>
            <p class="text-muted small mb-0">Minh bạch thông tin chứng chỉ chuyên môn, phòng khám và chi phí khám bệnh</p>
        </div>
        @if (userRole == "Doctor")
        {
            <a asp-action="Profile" class="btn btn-outline-primary px-3 shadow-sm">
                <i class="bi bi-person-gear me-1"></i>Hồ sơ của tôi
            </a>
        }
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Doctors Cards / List -->
    <div class="row g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-person-x fs-1 opacity-50 d-block mb-3"></i>
                <p>Hiện tại chưa có dữ liệu bác sĩ trong hệ thống.</p>
            </div>
        }
        else
        {
            @foreach (var doc in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4 text-center">
                            <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 75px; height: 75px;">
                                <i class="bi bi-heart-pulse fs-2"></i>
                            </div>

                            <h5 class="fw-bold mb-1">
                                <span class="badge bg-secondary me-1">@doc.AcademicTitle</span>
                                @doc.FullName
                            </h5>
                            <p class="text-primary fw-medium small mb-2">
                                <i class="bi bi-hospital me-1"></i>@doc.DepartmentName
                            </p>

                            <div class="text-muted small mb-3">
                                <span class="badge bg-light text-dark border me-1">
                                    <i class="bi bi-door-closed me-1"></i>Phòng @doc.DefaultRoomNumber
                                </span>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-telephone me-1"></i>@doc.PhoneNumber
                                </span>
                            </div>

                            <div class="p-2 bg-success-subtle rounded-3 border border-success-subtle mb-3">
                                <span class="text-success small fw-semibold d-block">Phí khám niêm yết:</span>
                                <span class="fs-5 fw-bold text-success">@doc.PricePerSlot.ToString("N0") đ</span>
                                <span class="text-muted small">/ 15 phút</span>
                            </div>

                            @if (userRole == "Admin")
                            {
                                <a asp-action="Profile" asp-route-id="@doc.DoctorId" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa hồ sơ & biểu phí
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

