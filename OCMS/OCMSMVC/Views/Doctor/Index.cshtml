@model List<OCMSMVC.Models.DoctorListItemViewModel>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Đội ngũ Bác sĩ";
    var userRole = Context.Session.GetString("Role");
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h4 class="fw-bold mb-0">Đội ngũ bác sĩ &amp; Biểu phí</h4>
        @if (userRole == "Doctor")
        {
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="openDoctorProfileModal()">
                Hồ sơ của tôi
            </button>
        }
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Doctors Cards / List -->
    <div class="row g-3">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                Hiện tại chưa có dữ liệu bác sĩ trong hệ thống.
            </div>
        }
        else
        {
            @foreach (var doc in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border">
                        <div class="card-body p-3 text-center">
                            <h5 class="fw-bold mb-1">
                                <span class="badge bg-secondary me-1">@doc.AcademicTitle</span>
                                @doc.FullName
                            </h5>
                            <div class="text-primary fw-medium small mb-2">@doc.DepartmentName</div>

                            <div class="small text-muted mb-3">
                                <span class="me-2">Phòng @doc.DefaultRoomNumber</span>
                                <span>@doc.PhoneNumber</span>
                            </div>

                            <div class="p-2 bg-light rounded border text-center">
                                <div class="text-muted small">Phí khám niêm yết</div>
                                <div class="fs-5 fw-bold text-primary">@doc.PricePerSlot.ToString("N0") VNĐ</div>
                                <small class="text-muted">/ 15 phút</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
