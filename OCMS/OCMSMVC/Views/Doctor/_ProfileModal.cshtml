@model OCMSMVC.Models.DoctorProfileViewModel

<div class="modal fade" id="doctorProfileModal" tabindex="-1" aria-labelledby="doctorProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="doctorProfileModalLabel">
                    Hồ sơ bác sĩ &amp; Biểu phí
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-controller="Doctor" asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="DepartmentId" />
                <input type="hidden" asp-for="DepartmentName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="IsAdminEditing" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="modal-body p-4">
                    <!-- Thông tin cơ bản (Chỉ đọc) -->
                    <div class="row g-3 mb-3 pb-3 border-bottom">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Chuyên khoa</label>
                            <input type="text" class="form-control bg-light" value="@Model.DepartmentName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Email</label>
                            <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Học hàm / Học vị -->
                        <div class="col-md-6">
                            <label asp-for="AcademicTitle" class="form-label fw-semibold small">Học hàm / Học vị <span class="text-danger">*</span></label>
                            <select asp-for="AcademicTitle" class="form-select">
                                <option value="BS">BS - Bác sĩ</option>
                                <option value="ThS.BS">ThS.BS - Thạc sĩ Bác sĩ</option>
                                <option value="BSCK1">BSCK1 - Bác sĩ Chuyên khoa 1</option>
                                <option value="BSCK2">BSCK2 - Bác sĩ Chuyên khoa 2</option>
                                <option value="TS.BS">TS.BS - Tiến sĩ Bác sĩ</option>
                                <option value="PGS.TS.BS">PGS.TS.BS - Phó Giáo sư Tiến sĩ Bác sĩ</option>
                            </select>
                            <span asp-validation-for="AcademicTitle" class="text-danger small"></span>
                        </div>

                        <!-- Họ và tên -->
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Phòng khám mặc định -->
                        <div class="col-md-6">
                            <label asp-for="DefaultRoomId" class="form-label fw-semibold small">Phòng khám mặc định</label>
                            <select asp-for="DefaultRoomId" class="form-select">
                                <option value="">-- Chưa chọn phòng --</option>
                                @foreach (var r in Model.AvailableRooms)
                                {
                                    <option value="@r.Id" selected="@(r.Id == Model.DefaultRoomId ? "selected" : null)">
                                        Phòng @r.RoomNumber
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Giá khám mỗi slot -->
                        <div class="col-12">
                            <label asp-for="PricePerSlot" class="form-label fw-semibold small">Giá khám mỗi lượt (VNĐ / 15 phút) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="PricePerSlot" class="form-control" type="number" step="5000" min="0" required />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="PricePerSlot" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="document.getElementById('logoutFormNavbar').submit();">
                            Đăng xuất
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary btn-sm px-3">Lưu thay đổi</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
